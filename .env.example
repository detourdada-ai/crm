# Copy this file to .env.local and fill in real values.

# Random secret used to sign the temporary admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Sprint 1 temporary login (see spec: admin / 1234). Replace with Supabase Auth later.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Supabase project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sprint 14-C: Resend (resend.com) — Beta welcome/ending emails. Leave blank
# to disable email sending entirely (signup/access-gate keep working either way).
RESEND_API_KEY=
# Optional — defaults to Resend's shared onboarding@resend.dev sender, which
# works without a verified domain.
RESEND_FROM_EMAIL=

# Sprint 14-C: shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when invoking /api/cron/beta-expiration. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Phase 1: 카카오 로컬 API(주소 검색/좌표 변환). Kakao Developers 앱의
# REST API 키 — Daum 우편번호 검색 팝업과는 별개 서비스라 별도 발급 필요.
# 서버에서만 사용(클라이언트 노출 금지). 없으면 지오코딩은 조용히
# 건너뛰고 geocode_status='failed'로 남는다(주문/고객 저장은 영향 없음).
KAKAO_REST_API_KEY=
